"res://HUD/": "teal",
"res://addons/": "red",
"res://assets/": "orange",
"res://gamemanager/": "green",
"res://levels/": "teal",
"res://materials/": "blue",
"res://meshes/": "blue",
"res://player/": "purple",
"res://scripts/": "pink"
}

